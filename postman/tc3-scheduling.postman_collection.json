{
  "info": {"_postman_id": "9f1a1e2b-7c3d-4a2e-9d3a-4b0a2f0e9a11", "name": "TC3 - Scheduling Service (JWT and Roles)", "description": "Rode a pasta 0 antes das demais. Ela obtém os JWTs usados nos testes de role.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "authBaseUrl", "value": "http://localhost:8080", "type": "string"}, {"key": "baseUrl", "value": "http://localhost:8081", "type": "string"}, {"key": "appointmentId", "value": "", "type": "string"}, {"key": "doctorToken", "value": "", "type": "string"}, {"key": "nurseToken", "value": "", "type": "string"}, {"key": "patientToken", "value": "", "type": "string"}],
  "item": [
    {"name": "0 - Obter tokens JWT", "item": [
      {"name": "Medico", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('doctorToken', pm.response.json().accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "dr.silva", "type": "string"}, {"key": "password", "value": "doctor123", "type": "string"}]}, "method": "POST", "url": "{{authBaseUrl}}/auth/token"}},
      {"name": "Enfermeiro", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('nurseToken', pm.response.json().accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "nurse.souza", "type": "string"}, {"key": "password", "value": "nurse123", "type": "string"}]}, "method": "POST", "url": "{{authBaseUrl}}/auth/token"}},
      {"name": "Paciente", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('patientToken', pm.response.json().accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "patient.jose", "type": "string"}, {"key": "password", "value": "patient123", "type": "string"}]}, "method": "POST", "url": "{{authBaseUrl}}/auth/token"}}
    ]},
    {"name": "1 - Sem autenticacao", "item": [{"name": "GET /appointments retorna 401", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 401', () => pm.response.to.have.status(401));"]}}], "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{baseUrl}}/appointments"}}]},
    {"name": "2 - Enfermeiro", "item": [
      {"name": "POST /appointments cria consulta", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('appointmentId', pm.response.json().id);"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{nurseToken}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"patientId\": 3,\n  \"doctorId\": 1,\n  \"dateTime\": \"2030-12-20T10:00:00\",\n  \"notes\": \"checkup de rotina\"\n}", "options": {"raw": {"language": "json"}}}, "url": "{{baseUrl}}/appointments"}},
      {"name": "PUT /appointments bloqueado para enfermeiro", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 403', () => pm.response.to.have.status(403));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{nurseToken}}", "type": "string"}]}, "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"patientId\": 3,\n  \"doctorId\": 1,\n  \"dateTime\": \"2030-12-20T11:00:00\",\n  \"notes\": \"tentativa bloqueada\"\n}", "options": {"raw": {"language": "json"}}}, "url": "{{baseUrl}}/appointments/{{appointmentId}}"}}
    ]},
    {"name": "3 - Medico", "item": [
      {"name": "GET /appointments lista consultas", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{doctorToken}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/appointments"}},
      {"name": "PUT /appointments edita consulta", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{doctorToken}}", "type": "string"}]}, "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"patientId\": 3,\n  \"doctorId\": 1,\n  \"dateTime\": \"2030-12-20T11:00:00\",\n  \"notes\": \"reagendado pelo medico\"\n}", "options": {"raw": {"language": "json"}}}, "url": "{{baseUrl}}/appointments/{{appointmentId}}"}},
      {"name": "POST /appointments bloqueado para medico", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 403', () => pm.response.to.have.status(403));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{doctorToken}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"patientId\": 3,\n  \"doctorId\": 1,\n  \"dateTime\": \"2030-12-22T10:00:00\",\n  \"notes\": \"tentativa bloqueada\"\n}", "options": {"raw": {"language": "json"}}}, "url": "{{baseUrl}}/appointments"}}
    ]},
    {"name": "4 - Paciente", "item": [
      {"name": "GET /appointments/me retorna somente consultas proprias", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.response.json().forEach(item => pm.expect(item.patientId).to.eql(3));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{patientToken}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/appointments/me"}},
      {"name": "GET /availability permitido para paciente", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{patientToken}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/availability?doctorId=1&date=2030-12-20"}},
      {"name": "GET /appointments bloqueado para paciente", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 403', () => pm.response.to.have.status(403));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{patientToken}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/appointments"}}
    ]}
  ]
}
