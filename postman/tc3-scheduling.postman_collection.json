								"exec": [
									"pm.test('Status 201 - enfermeiro pode registrar', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"if (pm.response.code === 201) {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('appointmentId', body.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{ "key": "username", "value": "nurse.souza", "type": "string" },
								{ "key": "password", "value": "nurse123", "type": "string" }
							]
