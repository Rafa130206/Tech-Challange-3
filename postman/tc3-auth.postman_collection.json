{
  "info": {"_postman_id": "7c3df5c8-cd19-4a53-9f4a-80ec085e2c2b", "name": "TC3 - Auth Service (JWT)", "description": "Emite JWTs usando Basic Auth somente no auth-service.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "baseUrl", "value": "http://localhost:8080", "type": "string"}, {"key": "accessToken", "value": "", "type": "string"}],
  "item": [
    {"name": "Medico - emitir token", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Retorna JWT Bearer', () => { pm.expect(body.tokenType).to.eql('Bearer'); pm.expect(body.accessToken).to.be.a('string'); });", "pm.collectionVariables.set('accessToken', body.accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "dr.silva", "type": "string"}, {"key": "password", "value": "doctor123", "type": "string"}]}, "method": "POST", "url": "{{baseUrl}}/auth/token"}},
    {"name": "Enfermeiro - emitir token", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "nurse.souza", "type": "string"}, {"key": "password", "value": "nurse123", "type": "string"}]}, "method": "POST", "url": "{{baseUrl}}/auth/token"}},
    {"name": "Paciente - emitir token", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "patient.jose", "type": "string"}, {"key": "password", "value": "patient123", "type": "string"}]}, "method": "POST", "url": "{{baseUrl}}/auth/token"}},
    {"name": "Credencial invalida retorna 401", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 401', () => pm.response.to.have.status(401));"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "invalido", "type": "string"}, {"key": "password", "value": "invalido", "type": "string"}]}, "method": "POST", "url": "{{baseUrl}}/auth/token"}}
  ]
}
