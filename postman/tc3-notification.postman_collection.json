{
  "info": {"_postman_id": "2df343e8-4dfe-4f05-bd52-c4da1d7233c7", "name": "TC3 - Notification Service (JWT and Roles)", "description": "Testa a consulta de notificacoes e o controle de acesso por JWT.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "authBaseUrl", "value": "http://localhost:8080", "type": "string"}, {"key": "baseUrl", "value": "http://localhost:8082", "type": "string"}, {"key": "doctorToken", "value": "", "type": "string"}, {"key": "nurseToken", "value": "", "type": "string"}, {"key": "patientToken", "value": "", "type": "string"}],
  "item": [
    {"name": "0 - Obter tokens JWT", "item": [
      {"name": "Medico", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set('doctorToken', pm.response.json().accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "dr.silva", "type": "string"}, {"key": "password", "value": "doctor123", "type": "string"}]}, "method": "POST", "url": "{{authBaseUrl}}/auth/token"}},
      {"name": "Enfermeiro", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set('nurseToken', pm.response.json().accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "nurse.souza", "type": "string"}, {"key": "password", "value": "nurse123", "type": "string"}]}, "method": "POST", "url": "{{authBaseUrl}}/auth/token"}},
      {"name": "Paciente", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set('patientToken', pm.response.json().accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "patient.jose", "type": "string"}, {"key": "password", "value": "patient123", "type": "string"}]}, "method": "POST", "url": "{{authBaseUrl}}/auth/token"}}
    ]},
    {"name": "1 - Sem autenticacao", "item": [{"name": "GET /notificacoes retorna 401", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 401', () => pm.response.to.have.status(401));"]}}], "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{baseUrl}}/notificacoes"}}]},
    {"name": "2 - Acessos permitidos", "item": [
      {"name": "Medico lista notificacoes", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Retorna lista', () => pm.expect(pm.response.json()).to.be.an('array'));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{doctorToken}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/notificacoes"}},
      {"name": "Enfermeiro lista notificacoes", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{nurseToken}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/notificacoes"}}
    ]},
    {"name": "3 - Paciente bloqueado", "item": [{"name": "GET /notificacoes retorna 403", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 403', () => pm.response.to.have.status(403));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{patientToken}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/notificacoes"}}]}
  ]
}
