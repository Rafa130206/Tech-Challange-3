  ],
  "item": [
    {
      "name": "Mutations",
      "item": [
        {
          "name": "Create history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('No GraphQL errors', () => pm.expect(body.errors).to.be.undefined);",
                  "pm.test('Returns created history id', () => pm.expect(body.data.create.id).to.exist);",
                  "pm.collectionVariables.set('schedulingId', body.data.create.schedulingId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateHistory($input: HistoryInput!) {\n  create(input: $input) {\n    id\n    schedulingId\n    patientId\n    doctorId\n    date\n    medicalRecords\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"schedulingId\": \"1\",\n    \"patientId\": \"10\",\n    \"doctorId\": \"20\",\n    \"date\": \"2026-08-30T14:30:00\",\n    \"medicalRecords\": \"Routine consultation\"\n  }\n}"
              }
            },
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] }
          }
        },
        {
          "name": "Update history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('No GraphQL errors', () => pm.expect(body.errors).to.be.undefined);",
                  "pm.test('doctorId updated', () => pm.expect(body.data.update.doctorId).to.eql('99'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateHistory($schedulingId: ID!, $input: HistoryInput!) {\n  update(schedulingId: $schedulingId, input: $input) {\n    id\n    schedulingId\n    doctorId\n    date\n    medicalRecords\n  }\n}",
                "variables": "{\n  \"schedulingId\": \"{{schedulingId}}\",\n  \"input\": {\n    \"schedulingId\": \"{{schedulingId}}\",\n    \"patientId\": \"10\",\n    \"doctorId\": \"99\",\n    \"date\": \"2026-08-30T15:00:00\",\n    \"medicalRecords\": \"Follow-up\"\n  }\n}"
              }
            },
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] }
          }
        },
        {
          "name": "Delete history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('No GraphQL errors', () => pm.expect(body.errors).to.be.undefined);",
                  "pm.test('delete returns true', () => pm.expect(body.data.delete).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation DeleteHistory($schedulingId: ID!) {\n  delete(schedulingId: $schedulingId)\n}",
                "variables": "{\n  \"schedulingId\": \"{{schedulingId}}\"\n}"
              }
            },
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] }
          }
        }
      ]
