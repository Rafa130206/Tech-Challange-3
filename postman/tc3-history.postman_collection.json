    {
      "name": "1 - Enfermeiro (NURSE)",
      "item": [
        {
          "name": "Criar prontuario (happy path)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Sem erro GraphQL', () => pm.expect(body.errors, JSON.stringify(body.errors)).to.be.undefined);",
            "pm.test('Prontuario criado', () => { pm.expect(body.data.create.id).to.exist; pm.expect(body.data.create.schedulingId).to.eql(pm.collectionVariables.get('schedulingId')); });"
          ]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{nurseToken}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "graphql", "graphql": {
              "query": "mutation Create($input: HistoryInput!) {\n  create(input: $input) {\n    id\n    schedulingId\n    patientId\n    doctorId\n    date\n    medicalRecords\n  }\n}",
              "variables": "{\n  \"input\": {\n    \"schedulingId\": \"{{schedulingId}}\",\n    \"patientId\": \"{{patientId}}\",\n    \"doctorId\": \"{{doctorId}}\",\n    \"date\": \"{{nowIso}}\",\n    \"medicalRecords\": \"Queixa de cefaleia ha 3 dias. Sem sinais de alarme. Registrado pela enfermagem.\"\n  }\n}"
            }},
            "url": "{{baseUrl}}/graphql"
          }
        },
        {
          "name": "Criar duplicado no mesmo schedulingId (erro)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('Retorna erro GraphQL', () => pm.expect(body.errors).to.be.an('array').that.is.not.empty);",
            "pm.test('Mensagem indica duplicidade', () => pm.expect(JSON.stringify(body.errors).toLowerCase()).to.include('already has a history'));"
