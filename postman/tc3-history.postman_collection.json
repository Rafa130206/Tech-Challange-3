    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8083", "type": "string" },
    { "key": "schedulingId", "value": "1", "type": "string" },
    { "key": "patientId", "value": "10", "type": "string" },
