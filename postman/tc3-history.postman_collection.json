          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{nurseToken}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "graphql", "graphql": {
              "query": "mutation Create($input: HistoryInput!) { create(input: $input) { id } }",
              "variables": "{\n  \"input\": {\n    \"schedulingId\": \"{{schedulingId}}\",\n    \"patientId\": \"{{patientId}}\",\n    \"doctorId\": \"{{doctorId}}\",\n    \"date\": \"{{nowIso}}\",\n    \"medicalRecords\": \"Segunda tentativa\"\n  }\n}"
            }},
            "url": "{{baseUrl}}/graphql"
