{
  "info": {"_postman_id": "b2f7c1a4-9d3e-4a11-8c6b-1e5f0a7d2c88", "name": "TC3 - History Service (GraphQL and JWT)", "description": "Testa o prontuario GraphQL e as permissoes de cada role. Rode a pasta 0 antes das demais.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "authBaseUrl", "value": "http://localhost:8080", "type": "string"}, {"key": "baseUrl", "value": "http://localhost:8083", "type": "string"}, {"key": "schedulingId", "value": "9001", "type": "string"}, {"key": "doctorToken", "value": "", "type": "string"}, {"key": "nurseToken", "value": "", "type": "string"}, {"key": "patientToken", "value": "", "type": "string"}],
  "item": [
    {"name": "0 - Obter tokens JWT", "item": [
      {"name": "Medico", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set('doctorToken', pm.response.json().accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "dr.silva", "type": "string"}, {"key": "password", "value": "doctor123", "type": "string"}]}, "method": "POST", "url": "{{authBaseUrl}}/auth/token"}},
      {"name": "Enfermeiro", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set('nurseToken', pm.response.json().accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "nurse.souza", "type": "string"}, {"key": "password", "value": "nurse123", "type": "string"}]}, "method": "POST", "url": "{{authBaseUrl}}/auth/token"}},
      {"name": "Paciente", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set('patientToken', pm.response.json().accessToken);"]}}], "request": {"auth": {"type": "basic", "basic": [{"key": "username", "value": "patient.jose", "type": "string"}, {"key": "password", "value": "patient123", "type": "string"}]}, "method": "POST", "url": "{{authBaseUrl}}/auth/token"}}
    ]},
    {"name": "1 - Enfermeiro", "item": [
      {"name": "Criar prontuario", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Sem erro GraphQL', () => pm.expect(body.errors).to.be.undefined);", "pm.test('Prontuario criado', () => pm.expect(body.data.create.id).to.exist);"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{nurseToken}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "graphql", "graphql": {"query": "mutation Create($input: HistoryInput!) { create(input: $input) { id schedulingId patientId } }", "variables": "{\n  \"input\": {\n    \"schedulingId\": \"{{schedulingId}}\",\n    \"patientId\": \"3\",\n    \"doctorId\": \"1\",\n    \"date\": \"2030-12-20T11:00:00\",\n    \"medicalRecords\": \"Consulta registrada pelo enfermeiro\"\n  }\n}"}}, "url": "{{baseUrl}}/graphql"}},
      {"name": "Excluir prontuario bloqueado para enfermeiro", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Erro GraphQL de autorizacao', () => pm.expect(pm.response.json().errors).to.be.an('array'));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{nurseToken}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "graphql", "graphql": {"query": "mutation { delete(schedulingId: \"{{schedulingId}}\") }", "variables": "{}"}}, "url": "{{baseUrl}}/graphql"}}
    ]},
    {"name": "2 - Medico", "item": [
      {"name": "Consultar prontuarios", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Sem erro GraphQL', () => pm.expect(body.errors).to.be.undefined);", "pm.test('Retorna lista', () => pm.expect(body.data.getAll).to.be.an('array'));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{doctorToken}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "graphql", "graphql": {"query": "query { getAll { id schedulingId patientId doctorId } }", "variables": "{}"}}, "url": "{{baseUrl}}/graphql"}},
      {"name": "Atualizar prontuario", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Sem erro GraphQL', () => pm.expect(body.errors).to.be.undefined);", "pm.test('Prontuario atualizado', () => pm.expect(body.data.update.medicalRecords).to.eql('Atualizado pelo medico'));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{doctorToken}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "graphql", "graphql": {"query": "mutation Update($id: ID!, $input: HistoryInput!) { update(schedulingId: $id, input: $input) { medicalRecords } }", "variables": "{\n  \"id\": \"{{schedulingId}}\",\n  \"input\": {\n    \"schedulingId\": \"{{schedulingId}}\",\n    \"patientId\": \"3\",\n    \"doctorId\": \"1\",\n    \"date\": \"2030-12-20T11:30:00\",\n    \"medicalRecords\": \"Atualizado pelo medico\"\n  }\n}"}}, "url": "{{baseUrl}}/graphql"}}
    ]},
    {"name": "3 - Paciente", "item": [
      {"name": "myHistory retorna somente registros proprios", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Sem erro GraphQL', () => pm.expect(body.errors).to.be.undefined);", "body.data.myHistory.forEach(item => pm.expect(item.patientId).to.eql('3'));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{patientToken}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "graphql", "graphql": {"query": "query { myHistory { id schedulingId patientId doctorId medicalRecords } }", "variables": "{}"}}, "url": "{{baseUrl}}/graphql"}},
      {"name": "getAll bloqueado para paciente", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Erro GraphQL de autorizacao', () => pm.expect(pm.response.json().errors).to.be.an('array'));"]}}], "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{patientToken}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "graphql", "graphql": {"query": "query { getAll { id } }", "variables": "{}"}}, "url": "{{baseUrl}}/graphql"}}
    ]}
  ]
